@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<section class="auth">
    <div class="card auth-card">
        <p class="eyebrow">Private portfolio</p>
        <h1>Sign in</h1>
        <p class="muted">Use the credentials listed in the project README.</p>

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>

            <div class="field">
                <label asp-for="Username"></label>
                <input asp-for="Username" autocomplete="username" autofocus maxlength="50" />
                <span asp-validation-for="Username" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="current-password" maxlength="100" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Sign in</button>
        </form>
    </div>
</section>